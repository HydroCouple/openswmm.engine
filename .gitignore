
.DS_Store

# Working notes not intended for version control
doc/FlashX_SWMM_crosswalk.md
doc/Verification_Implementation_Plan.md
# plans/transport is TRACKED (user decision 2026-09-01, closing the debt
# UNIFIED_PLAN_STATUS §8 carried twice: the entire plan corpus -- roadmap,
# handoffs, ~217 numbered lessons -- existed in one working tree on one
# machine, unprotected by the very version control it documents). Everything
# else under /plans/ stays out. The _scratch subtree stays out too: it is
# working notes, not record.
/plans/*
!/plans/transport/
/plans/transport/_scratch/
/tools/
docs/2D_MULTISCALE_FORMULATION_REVIEW.md
# Ignore examples/ contents (not the dir itself, so the fixture below can be
# re-included; git cannot re-include files under an excluded directory).
/examples/*
# Keep the canonical 2D fixture — tests/unit/engine/CMakeLists.txt and
# python/tests/engine/{test_2d_evap,test_surface2d_view}.py load it from here.
!/examples/2d_complete_example.inp

