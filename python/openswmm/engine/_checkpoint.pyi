from os import PathLike
from typing import Any

class Checkpoints:
    def __init__(self, owner: Any) -> None: ...
    @property
    def capabilities(self) -> int: ...
    @property
    def session_status(self) -> int: ...
    def start_session(self, output: int = 0, *, source_history: str | PathLike[str] | None = None, detailed_source_intervals: bool = False, ownership_token: str | None = None) -> None: ...
    def inspect(self, path: str | PathLike[str]) -> dict[str, Any]: ...
    def save(self, path: str | PathLike[str]) -> None: ...
    def restore(self, path: str | PathLike[str]) -> None: ...
    @staticmethod
    def export_bundle(path: str | PathLike[str], new_folder: str | PathLike[str]) -> None: ...
