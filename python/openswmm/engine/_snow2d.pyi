from typing import Any

class MeshSnow:
    """Mesh assignments and accepted snapshots; state indices are zero based."""
    def __init__(self, owner: Any) -> None: ...
    def configuration(self) -> dict[str, str]: ...
    def apply_configuration(self, options: str = '', defaults: str = '', cells: str = '') -> None: ...
    def states(self) -> list[dict[str, float | int]]: ...
    def ledgers(self) -> list[dict[str, float]]: ...
    @property
    def options(self) -> dict[str, str | float]: ...
    def rows(self, section: str = 'defaults') -> list[dict[str, str | float | int]]: ...
