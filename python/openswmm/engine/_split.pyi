from __future__ import annotations

from typing import TYPE_CHECKING
from collections.abc import Callable
from types import TracebackType
from ._access import EngineView
from ._enums import SplitPhase, SplitRole

if TYPE_CHECKING:
    from ._solver import Solver

class SplitFrame:
    def __init__(self, solver: Solver | None = ...) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> SplitFrame: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc: BaseException | None,
        traceback: TracebackType | None,
    ) -> None: ...
    @property
    def phase(self) -> int: ...
    @property
    def time(self) -> tuple[int, float, float]: ...
    def node(self, index: int) -> dict[str, float]: ...
    def source(self, index: int) -> dict[str, float]: ...
    def outfall_return(self, subcatchment: int) -> float: ...

class SplitParticipant(EngineView):
    def __init__(self, owner: Solver) -> None: ...
    def validate_input(self) -> None: ...
    def configure(self, role: SplitRole | int) -> None: ...
    def geometry(self) -> SplitFrame: ...
    def apply_geometry(self, frame: SplitFrame) -> None: ...
    def set_callback(
        self, callback: Callable[[SplitPhase, SplitFrame], SplitFrame] | None
    ) -> None: ...
    def evaluate(self, phase: SplitPhase | int, request: SplitFrame) -> SplitFrame: ...
    def encode(self, frame: SplitFrame) -> str: ...
    def decode(self, text: str) -> SplitFrame: ...

class MaterialSplitParticipant(SplitParticipant):
    def validate_input(self) -> None: ...
    def configure(self, role: SplitRole | int) -> None: ...
    # Inherited from SplitParticipant; declared here so the catalog lists them.
    def geometry(self) -> SplitFrame: ...
    def apply_geometry(self, frame: SplitFrame) -> None: ...
    def set_callback(
        self, callback: Callable[[SplitPhase, SplitFrame], SplitFrame] | None
    ) -> None: ...
    def evaluate(self, phase: SplitPhase | int, request: SplitFrame) -> SplitFrame: ...
    def set_transport(self, callback: Callable[[int, str], str]) -> None: ...
    def bind(self, surface: Solver, capacity: int = ...) -> None: ...
    def encode(self, frame: SplitFrame) -> str: ...
    def decode(self, text: str) -> SplitFrame: ...
    def copy_packet(self, text: str) -> str: ...
    def checkpoint_capabilities(self) -> int: ...
    def checkpoint_prepare_outputs(self) -> None: ...
    def checkpoint_enable(self, outputs: bool = ...) -> None: ...
    def checkpoint_capture(self) -> bytes: ...
    def checkpoint_restore(self, data: bytes, expected_seconds: float | None = ...) -> None: ...
