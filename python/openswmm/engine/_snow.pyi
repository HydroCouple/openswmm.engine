from collections.abc import Iterable
from typing import Any

class Snow:
    """SI snow parameters and accepted state; unavailable quantities remain NaN."""
    def __init__(self, owner: Any) -> None: ...
    @property
    def model(self) -> str: ...
    @model.setter
    def model(self, value: str) -> None: ...
    @property
    def step_seconds(self) -> float: ...
    @step_seconds.setter
    def step_seconds(self, value: float) -> None: ...
    def option(self, key: str) -> str: ...
    def set_option(self, key: str, value: str | float) -> None: ...
    @property
    def monthly_ranges(self) -> list[float]: ...
    @monthly_ranges.setter
    def monthly_ranges(self, values: Iterable[float]) -> None: ...
    def pack(self, name: str) -> dict[str, float | int]: ...
    def set_pack(self, name: str, changes: dict[str, float | int] | None = None, **fields: float | int) -> None: ...
    def state(self, subcatch: str | int, surface: int = 2) -> dict[str, float | int]: ...
    def ledger(self) -> dict[str, float]: ...
    def apply_configuration(self, temperature_rows: str = '', ueb_rows: str = '', *, cloud: dict[str, Any] | None = None) -> None: ...

    @property
    def radiation(self) -> dict[str, float | int]: ...
    @radiation.setter
    def radiation(self, values: dict[str, float | int]) -> None: ...
    def radiation_source(self, channel: int) -> str: ...
    def set_radiation_source(self, channel: int, value: str) -> None: ...
    @property
    def cloud(self) -> dict[str, float | int | str]: ...
    def preview_meteorology(self, path: str) -> dict[str, Any]: ...
    def apply_packs(self, rows: Iterable[dict[str, Any]]) -> None: ...
