"""Native saved 2D result access; independent of a running solver."""
from __future__ import annotations
from os import PathLike
from typing import Any
import numpy as np
from numpy.typing import NDArray

class Output2DReader:
    def __init__(self, path: str | PathLike[str]) -> None: ...
    @staticmethod
    def available() -> bool: ...
    @property
    def path(self) -> str: ...
    @property
    def datasets(self) -> tuple[str, ...]: ...
    def attributes(self, path: str = "/") -> dict[str, str]: ...
    def shape(self, path: str) -> tuple[tuple[int, ...], np.dtype[Any]]: ...
    def unlimited_axes(self, path: str) -> tuple[int, ...]: ...
    def strings(self, path: str) -> tuple[str, ...]: ...
    def read(self, path: str, selection: Any = None) -> NDArray[Any]: ...
    def close(self) -> None: ...
    def __enter__(self) -> Output2DReader: ...
    def __exit__(self, *args: Any) -> bool: ...
