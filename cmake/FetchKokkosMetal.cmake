include_guard(GLOBAL)
set(OPENSWMM_KOKKOS_SOURCE_DIR "" CACHE PATH "Override the Apple GPU Kokkos source checkout")
set(OPENSWMM_KOKKOS_GIT_REPOSITORY "https://github.com/HydroCouple/kokkos.git" CACHE STRING "Apple GPU Kokkos fork")
set(OPENSWMM_KOKKOS_GIT_TAG "" CACHE STRING "Override the pinned Apple GPU Kokkos revision")
if(NOT OPENSWMM_KOKKOS_GIT_TAG)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/KokkosMetalRevision.txt")
    file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/KokkosMetalRevision.txt" OPENSWMM_KOKKOS_GIT_TAG LIMIT_COUNT 1)
endif()

# Called only from the AdaptiveCpp child build. The host plugin owns a different Kokkos ABI.
function(openswmm_fetch_metal_kokkos)
    include(FetchContent)
    get_filename_component(sibling "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../kokkos" ABSOLUTE)
    if(OPENSWMM_KOKKOS_SOURCE_DIR)
        if(NOT EXISTS "${OPENSWMM_KOKKOS_SOURCE_DIR}/CMakeLists.txt")
            message(FATAL_ERROR "Invalid OPENSWMM_KOKKOS_SOURCE_DIR: ${OPENSWMM_KOKKOS_SOURCE_DIR}")
        endif()
        set(source "${OPENSWMM_KOKKOS_SOURCE_DIR}")
    elseif(EXISTS "${sibling}/CMakeLists.txt")
        set(source "${sibling}")
    endif()
    if(source)
        message(STATUS "Metal worker: using Kokkos checkout ${source}")
        FetchContent_Declare(kokkos SOURCE_DIR "${source}")
    else()
        message(STATUS "Metal worker: fetching ${OPENSWMM_KOKKOS_GIT_REPOSITORY} @ ${OPENSWMM_KOKKOS_GIT_TAG}")
        FetchContent_Declare(kokkos GIT_REPOSITORY "${OPENSWMM_KOKKOS_GIT_REPOSITORY}"
            GIT_TAG "${OPENSWMM_KOKKOS_GIT_TAG}")
    endif()
    FetchContent_MakeAvailable(kokkos)
endfunction()
