;; Bit-identity corpus deck -- twod_coupled_quality.inp with its mesh in a
;; [2D_MESH_FILE] sidecar.
;;
;; Added 2026-11-11 (mesh open plan E0). No other corpus deck reads a sidecar,
;; so twoD::load2DMeshExternalFile -- the GUI's default mesh save mode -- was
;; outside every corpus net. The model is twod_coupled_quality.inp unchanged:
;; [2D_VERTICES], [2D_TRIANGLES], [2D_VERTEX_NODE_MAP] and [2D_INITIAL_QUALITY]
;; moved to twod_coupled_quality_sidecar.2dm (tracked beside this deck,
;; resolved relative to it), which also carries the writer's `;; UNITS: SI (m)`
;; header. Its .out must equal twod_coupled_quality's; a movement in ONLY this
;; deck is the sidecar loader.

[TITLE]
Overland transport: coupled pan with species and dispersion

[OPTIONS]
FLOW_UNITS           CMS
FLOW_ROUTING         DYNWAVE
START_DATE           01/01/2026
START_TIME           00:00:00
END_DATE             01/01/2026
END_TIME             00:30:00
REPORT_STEP          00:01:00
WET_STEP             00:01:00
DRY_STEP             00:01:00
ROUTING_STEP         5
ALLOW_PONDING        NO

[POLLUTANTS]
;;Name  Units  Crain  Cgw  Crdii  Kdecay
Cu      MG/L   2.0    0    0      0

[JUNCTIONS]
;;Name  Elev  MaxDepth  InitDepth  SurDepth  Aponded
J1      0.0   1.0       0          0         0

[OUTFALLS]
;;Name  Elev   Type  Gated
O1      -0.5   FREE  NO

[CONDUITS]
;;Name  From  To  Length  N      Zin  Zout  Q0
C1      J1    O1  30.0    0.013  0    0     0

[XSECTIONS]
;;Link  Shape     Geom1  Geom2  Geom3  Geom4  Barrels
C1      CIRCULAR  0.3    0      0      0      1

[2D_OPTIONS]
INTEGRATOR       EXPLICIT
LTS_TIERS        2
MAX_TIMESTEP     5
DRY_DEPTH        0.001
COUPLING_CD      0.7
DISPERSION       0.05
REPORT_2D        NO

[2D_MESH_FILE]
FILE twod_coupled_quality_sidecar.2dm

[REPORT]
INPUT      NO
CONTINUITY YES
NODES ALL
LINKS ALL
