+struct Trial {
+    const std::string mode =
+        std::getenv("GW_STUDY_POLICY") ? std::getenv("GW_STUDY_POLICY") : "off";
+    const double eps = std::getenv("GW_STUDY_EPS") ? std::stod(std::getenv("GW_STUDY_EPS")) : 0.05;
+    const bool trace = std::getenv("GW_STUDY_COMMITS") != nullptr;
+    const bool rates =
+        mode == "combined" || mode == "rates" || mode == "native" || mode == "native_only";
+    const bool receipts = mode == "combined" || mode == "receipts" || mode == "native";
+    std::vector<double> observed, bound;
+    std::ofstream log, early;
+    Trial() {
+        if (!(eps > 0 && eps < 1) || (!rates && !receipts && mode != "off"))
+            throw std::runtime_error("Unknown held-head study policy or invalid tolerance");
+        if (trace) {
+            log.open("commits.csv");
+            log << std::setprecision(17)
+                << "cell,start_s,end_s,head_before,head_after,intake_m3,lateral_m3,deep_m3,boundary_net_m3,et_m3,stability_s\n";
+        }
+        if (receipts) {
+            early.open("early.csv");
+            early << std::setprecision(17) << "time_s,cell,vin,vout,bin,bout\n";
+        }
+    }
+    void resize(int n) {
+        observed.resize(n);
+        bound.resize(n, 1e30);
+    }
+};
+inline Trial& experiment() {
+    static Trial value;
+    return value;
+}
+}
