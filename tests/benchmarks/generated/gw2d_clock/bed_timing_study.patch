+++ b/src/engine/2d/subsurface/GwBedStudy.hpp
@@ -0,0 +1,64 @@
+// Isolated single-bed water-only experiment. Start one process per simulation.
+#pragma once
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <string>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+namespace openswmm::twoD::bed_study {
+struct Packet {
+    double end, vol;
+};
+struct Journal {
+    std::vector<Packet> prescribed;
+    std::size_t next = 0;
+    bool replay = false;
+    std::ofstream log{"bed.csv"};
+    Journal() {
+        log.precision(std::numeric_limits<double>::max_digits10);
+        log << "delivery_s,volume_m3,check_s\n";
+        const char* path = std::getenv("GW_STUDY_REPLAY");
+        replay = path != nullptr;
+        if (!path)
+            path = std::getenv("GW_STUDY_EVENTS");
+        if (path) {
+            std::ifstream stream(path);
+            std::string line;
+            if (!std::getline(stream, line) || line != "delivery_s,volume_m3,check_s")
+                throw std::runtime_error("invalid reference journal");
+            while (std::getline(stream, line)) {
+                Packet p;
+                double check;
+                if (std::sscanf(line.c_str(), "%lf,%lf,%lf", &p.end, &p.vol, &check) != 3 ||
+                    (!prescribed.empty() && p.end <= prescribed.back().end) ||
+                    !std::isfinite(p.end) || !std::isfinite(p.vol) || p.end <= 0 || p.vol <= 0 ||
+                    p.end != check)
+                    throw std::runtime_error(
+                        "reference must be chronological aquifer-to-node flow");
+                prescribed.push_back(p);
+            }
+            if (prescribed.empty())
+                throw std::runtime_error("empty reference");
+        }
+    }
+    std::vector<Packet> packets(double end, double live) {
+        std::vector<Packet> batch;
+        if (replay) {
+            while (next < prescribed.size() && prescribed[next].end <= end)
+                batch.push_back(prescribed[next++]);
+        } else if (live != 0) {
+            batch.push_back({end, live});
+        }
+        for (auto p : batch)
+            log << p.end << ',' << p.vol << ',' << end << '\n';
+        return batch;
+    }
+};
+inline Journal& journal() {
+    static Journal value;
+    return value;
+}
+}
