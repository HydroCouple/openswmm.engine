[TITLE]
;; SWMMVis worker smoke deck.
;; Stock SWMM 5 grammar, one hour of rain on one subcatchment through two
;; junctions to an outfall -- PLUS one v6-only section ([USER_FLAGS]) and one
;; v6-only option (NODE_CONTINUITY) that stock 5.2.4 rejects with ERROR 205.
;; The SWMMVis backports must skip both with a warning and still run.

[OPTIONS]
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         DYNWAVE
START_DATE           01/01/2026
START_TIME           00:00:00
REPORT_START_DATE    01/01/2026
REPORT_START_TIME    00:00:00
END_DATE             01/01/2026
END_TIME             01:00:00
SWEEP_START          01/01
SWEEP_END            12/31
DRY_DAYS             0
REPORT_STEP          00:05:00
WET_STEP             00:01:00
DRY_STEP             00:05:00
ROUTING_STEP         0:00:30
NODE_CONTINUITY      YES
ALLOW_PONDING        NO
INERTIAL_DAMPING     PARTIAL
NORMAL_FLOW_LIMITED  BOTH
MIN_SURFAREA         12.566
MAX_TRIALS           8
HEAD_TOLERANCE       0.005

[EVAPORATION]
CONSTANT             0.0
DRY_ONLY             NO

[RAINGAGES]
;;Name           Format    Interval SCF      Source
RG1              INTENSITY 0:05     1.0      TIMESERIES TS1

[SUBCATCHMENTS]
;;Name           Rain Gage        Outlet           Area     %Imperv  Width    %Slope   CurbLen
S1               RG1              J1               10       50       500      0.5      0

[SUBAREAS]
;;Subcatchment   N-Imperv   N-Perv     S-Imperv   S-Perv     PctZero    RouteTo
S1               0.01       0.1        0.05       0.05       25         OUTLET

[INFILTRATION]
;;Subcatchment   MaxRate    MinRate    Decay      DryTime    MaxInfil
S1               3.0        0.5        4          7          0

[JUNCTIONS]
;;Name           Elevation  MaxDepth   InitDepth  SurDepth   Aponded
J1               100        4          0          0          0
J2               98         4          0          0          0

[OUTFALLS]
;;Name           Elevation  Type       Stage Data       Gated
O1               95         FREE                        NO

[CONDUITS]
;;Name           From Node        To Node          Length     Roughness  InOffset   OutOffset  InitFlow   MaxFlow
C1               J1               J2               400        0.013      0          0          0          0
C2               J2               O1               400        0.013      0          0          0          0

[XSECTIONS]
;;Link           Shape        Geom1            Geom2      Geom3      Geom4      Barrels
C1               CIRCULAR     1.5              0          0          0          1
C2               CIRCULAR     1.5              0          0          0          1

[TIMESERIES]
;;Name           Date       Time       Value
TS1                         0:00       0.5
TS1                         0:05       1.0
TS1                         0:10       2.0
TS1                         0:15       2.5
TS1                         0:20       2.0
TS1                         0:25       1.0
TS1                         0:30       0.5
TS1                         0:35       0.0

[USER_FLAGS]
;; v6-only section: stock 5.2.4 stops with ERROR 205 here.
J1               review

[REPORT]
INPUT                NO
CONTROLS             NO
SUBCATCHMENTS        ALL
NODES                ALL
LINKS                ALL

[COORDINATES]
;;Node           X-Coord            Y-Coord
J1               0                  0
J2               400                0
O1               800                0
