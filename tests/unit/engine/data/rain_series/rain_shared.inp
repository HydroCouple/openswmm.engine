[TITLE]
;;Fixture for the single-read multi-column tests (test_gage_rain_series).
;;
;;Four USER_CSV gages and two FILE timeseries all reference ONE file
;;(rain_multi.csv). The parse-once cache must read it exactly once per
;;resolve pass (plan MULTICOLUMN_SERIES_SINGLE_READ_2026-08-17 §5).
;;
;;CSV_DEFAULT has an EMPTY column selector ("rain_multi.csv:") — the B2 fix
;;makes it read the file's FIRST data column (EAST_GAGE).
;;
;;CSV_BARE is the shape InpWriter now emits for a USER_CSV gage whose column
;;is empty: a BARE path, no trailing colon, no station/units tokens. It must
;;re-load as USER_CSV reading the first data column, not as a STAN_PRCP gage
;;that reads a CSV as a station file and yields a silently empty series.

[OPTIONS]
FLOW_UNITS          	CFS
INFILTRATION        	HORTON
FLOW_ROUTING        	DYNWAVE
START_DATE          	01/01/2020
START_TIME          	00:00:00
END_DATE            	01/01/2020
END_TIME            	02:00:00
REPORT_STEP         	00:15:00
WET_STEP            	00:05:00
DRY_STEP            	01:00:00
ROUTING_STEP        	0:00:20

[EVAPORATION]
CONSTANT        	0.0
DRY_ONLY        	NO

[RAINGAGES]
;;Name          	Format   	Interval	SCF     	Source
CSV_EAST        	VOLUME   	0:15    	1.0     	FILE      	"rain_multi.csv:EAST_GAGE"
CSV_WEST        	VOLUME   	0:15    	1.0     	FILE      	"rain_multi.csv:WEST_GAGE"
CSV_DEFAULT     	VOLUME   	0:15    	1.0     	FILE      	"rain_multi.csv:"
CSV_BARE        	VOLUME   	0:15    	1.0     	FILE      	"rain_multi.csv"

[SUBCATCHMENTS]
;;Name          	Rain Gage       	Outlet          	Area    	%Imperv 	Width   	%Slope  	CurbLen
S_EAST          	CSV_EAST        	OUT1            	5       	25      	500     	0.5     	0
S_WEST          	CSV_WEST        	OUT1            	5       	25      	500     	0.5     	0
S_DEF           	CSV_DEFAULT     	OUT1            	5       	25      	500     	0.5     	0
S_BARE          	CSV_BARE        	OUT1            	5       	25      	500     	0.5     	0

[SUBAREAS]
;;Subcatchment  	N-Imperv  	N-Perv    	S-Imperv  	S-Perv    	PctZero   	RouteTo
S_EAST          	0.01      	0.1       	0.05      	0.05      	25        	OUTLET
S_WEST          	0.01      	0.1       	0.05      	0.05      	25        	OUTLET
S_DEF           	0.01      	0.1       	0.05      	0.05      	25        	OUTLET
S_BARE          	0.01      	0.1       	0.05      	0.05      	25        	OUTLET

[INFILTRATION]
S_EAST          	3.0       	0.5       	4         	7         	0
S_WEST          	3.0       	0.5       	4         	7         	0
S_DEF           	3.0       	0.5       	4         	7         	0
S_BARE          	3.0       	0.5       	4         	7         	0

[OUTFALLS]
;;Name          	Elevation 	Type      	Stage Data      	Gated
OUT1            	0         	FREE      	                	NO

[TIMESERIES]
;;Name          	Date      	Time      	Value
TS_EAST         	FILE      	"rain_multi.csv:EAST_GAGE"
TS_FIRST        	FILE      	"rain_multi.csv"

[REPORT]
SUBCATCHMENTS	ALL
NODES	ALL
LINKS	ALL

[MAP]
DIMENSIONS	0.000	0.000	1000.000	1000.000
Units     	None

[COORDINATES]
OUT1            	500.000           	0.000
