[TITLE]
;;Fixture: a FILE timeseries whose file opens but yields ZERO parseable
;;rows must FAIL the open (previously a silent empty series).

[OPTIONS]
FLOW_UNITS          	CFS
INFILTRATION        	HORTON
FLOW_ROUTING        	DYNWAVE
START_DATE          	01/01/2020
START_TIME          	00:00:00
END_DATE            	01/01/2020
END_TIME            	02:00:00
REPORT_STEP         	00:15:00
WET_STEP            	00:05:00
DRY_STEP            	01:00:00
ROUTING_STEP        	0:00:20

[EVAPORATION]
CONSTANT        	0.0
DRY_ONLY        	NO

[RAINGAGES]
;;Name          	Format   	Interval	SCF     	Source
TS_GAGE         	INTENSITY	0:15    	1.0     	TIMESERIES	TS_RAIN

[SUBCATCHMENTS]
;;Name          	Rain Gage       	Outlet          	Area    	%Imperv 	Width   	%Slope  	CurbLen
S_TS            	TS_GAGE         	OUT1            	5       	25      	500     	0.5     	0

[SUBAREAS]
;;Subcatchment  	N-Imperv  	N-Perv    	S-Imperv  	S-Perv    	PctZero   	RouteTo
S_TS            	0.01      	0.1       	0.05      	0.05      	25        	OUTLET

[INFILTRATION]
S_TS            	3.0       	0.5       	4         	7         	0

[OUTFALLS]
;;Name          	Elevation 	Type      	Stage Data      	Gated
OUT1            	0         	FREE      	                	NO

[TIMESERIES]
;;Name          	Date      	Time      	Value
TS_RAIN         	01/01/2020	00:00     	0.0
TS_RAIN         	          	00:15     	1.6
TS_JUNK         	FILE      	"rain_garbage.csv"

[REPORT]
SUBCATCHMENTS	ALL

[MAP]
DIMENSIONS	0.000	0.000	1000.000	1000.000
Units     	None

[COORDINATES]
OUT1            	500.000           	0.000
