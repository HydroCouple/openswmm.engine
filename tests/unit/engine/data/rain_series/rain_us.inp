[TITLE]
;;Fixture for test_gage_rain_series (US flow units, so unitsFactor is 1.0).
;;
;;Four gages exercise every path the resolved-series API has to cover:
;;  TS_GAGE   TIMESERIES, INTENSITY  -> reads the shared table pool
;;  STD_GAGE  FILE, STAN_PRCP, VOLUME, station STA_A
;;  CSV_EAST  FILE, USER_CSV, VOLUME, column EAST_GAGE
;;  CSV_WEST  FILE, USER_CSV, VOLUME, column WEST_GAGE  (same file, other column)
;;
;;CSV_EAST carries a scale factor of 2.0 so the API is shown to fold it in.

[OPTIONS]
FLOW_UNITS          	CFS
INFILTRATION        	HORTON
FLOW_ROUTING        	DYNWAVE
START_DATE          	01/01/2020
START_TIME          	00:00:00
END_DATE            	01/01/2020
END_TIME            	02:00:00
REPORT_STEP         	00:15:00
WET_STEP            	00:05:00
DRY_STEP            	01:00:00
ROUTING_STEP        	0:00:20

[EVAPORATION]
CONSTANT        	0.0
DRY_ONLY        	NO

[RAINGAGES]
;;Name          	Format   	Interval	SCF     	Source
TS_GAGE         	INTENSITY	0:15    	1.0     	TIMESERIES	TS_RAIN
STD_GAGE        	VOLUME   	0:15    	1.0     	FILE      	"rain_series/rain_std.dat"	STA_A	IN
CSV_EAST        	VOLUME   	0:15    	1.0     	FILE      	"rain_series/rain_multi.csv:EAST_GAGE"	2.0
CSV_WEST        	VOLUME   	0:15    	1.0     	FILE      	"rain_series/rain_multi.csv:WEST_GAGE"

[SUBCATCHMENTS]
;;Name          	Rain Gage       	Outlet          	Area    	%Imperv 	Width   	%Slope  	CurbLen
S_TS            	TS_GAGE         	OUT1            	5       	25      	500     	0.5     	0
S_STD           	STD_GAGE        	OUT1            	5       	25      	500     	0.5     	0
S_EAST          	CSV_EAST        	OUT1            	5       	25      	500     	0.5     	0
S_WEST          	CSV_WEST        	OUT1            	5       	25      	500     	0.5     	0

[SUBAREAS]
;;Subcatchment  	N-Imperv  	N-Perv    	S-Imperv  	S-Perv    	PctZero   	RouteTo
S_TS            	0.01      	0.1       	0.05      	0.05      	25        	OUTLET
S_STD           	0.01      	0.1       	0.05      	0.05      	25        	OUTLET
S_EAST          	0.01      	0.1       	0.05      	0.05      	25        	OUTLET
S_WEST          	0.01      	0.1       	0.05      	0.05      	25        	OUTLET

[INFILTRATION]
S_TS            	3.0       	0.5       	4         	7         	0
S_STD           	3.0       	0.5       	4         	7         	0
S_EAST          	3.0       	0.5       	4         	7         	0
S_WEST          	3.0       	0.5       	4         	7         	0

[OUTFALLS]
;;Name          	Elevation 	Type      	Stage Data      	Gated
OUT1            	0         	FREE      	                	NO

[TIMESERIES]
;;Name          	Date      	Time      	Value
TS_RAIN         	01/01/2020	00:00     	0.0
TS_RAIN         	          	00:15     	1.6
TS_RAIN         	          	00:30     	3.2
TS_RAIN         	          	00:45     	0.0

[REPORT]
SUBCATCHMENTS	ALL
NODES	ALL
LINKS	ALL

[MAP]
DIMENSIONS	0.000	0.000	1000.000	1000.000
Units     	None

[COORDINATES]
OUT1            	500.000           	0.000
