[TITLE]
Case-insensitive cross references (legacy hash.c parity) — must parse and run.
Node defined as ChestnutHillRes_IM; conduit endpoint, inflow and control rule
reference it with other case spellings (the MWRA deck typo, lowercase h).

[OPTIONS]
FLOW_UNITS           CFS
FLOW_ROUTING         DYNWAVE
START_DATE           01/01/2026
START_TIME           00:00:00
END_DATE             01/01/2026
END_TIME             01:00:00
REPORT_STEP          00:05:00
ROUTING_STEP         5

[JUNCTIONS]
;;Name  Elev  MaxDepth
J1      100   10

[STORAGE]
;;Name              Elev  MaxDepth  InitDepth  Shape       CurveCoeff  Exponent  Constant
ChestnutHillRes_IM  90    10        0          FUNCTIONAL  0           0         1000

[OUTFALLS]
;;Name  Elev  Type  Gated
OUT1    80    FREE  NO

[CONDUITS]
;;Name  FromNode  ToNode              Length  Roughness  InOffset  OutOffset  InitFlow
C1      J1        ChestnuthillRes_IM  400     0.013      0         0          0

[ORIFICES]
;;Name  FromNode            ToNode  Type  Offset  Cd    Gated  CloseTime
OR1     CHESTNUTHILLRES_IM  OUT1    SIDE  0       0.65  NO     0

[XSECTIONS]
;;Link  Shape     Geom1  Geom2  Geom3  Geom4  Barrels
C1      CIRCULAR  2      0      0      0      1
OR1     CIRCULAR  1      0      0      0

[INFLOWS]
;;Node              Constituent  TimeSeries  Type  Mfactor  Sfactor  Baseline
chestnuthillres_im  FLOW         ""          FLOW  1.0      1.0      5

[CONTROLS]
RULE GateClose
IF NODE ChestnuthillRes_IM HEAD <= 92.6
THEN ORIFICE or1 SETTING = 0

RULE GateOpen
IF NODE ChestnutHillRes_IM DEPTH > 3
THEN ORIFICE OR1 SETTING = 1

[REPORT]
CONTROLS   YES
INPUT      NO
