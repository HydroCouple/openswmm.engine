;; Reaction system configuration — written by OpenSWMM.

[REACTION_OPTIONS]
SOLVER     RK5
COUPLING   NONE
RATE_UNITS SEC
AREA_UNITS FT2
PATTERN_TIMESTEP 3600
TIMESTEP   0
ATOL       1e-06
RTOL       0.0001
TEMPERATURE 20

[REACTION_SPECIES]
;;Kind     Name             Units            [Atol]       [Rtol]
BULK       X                MG

[REACTION_PIPES]
;;Form     Species          Expression
RATE       X                0

[REACTION_TANKS]
;;Form     Species          Expression
RATE       X                0
