[EVAPORATION]
;;Type       Parameters
;;---------- ----------
CONSTANT     0
DRY_ONLY     NO

[JUNCTIONS]
;;Name             Elev         MaxDepth     InitDepth    SurDepth     Aponded     
;;---------------- ------------ ------------ ------------ ------------ ------------
J1               10 5 0 0 0
J2               9 5 0 0 0

[OUTFALLS]
;;Name             Elev         Type         Stage Data       Gated    Route To        
;;---------------- ------------ ------------ ---------------- -------- ----------------
O1               8 FREE         NO      

[CONDUITS]
;;Name             FromNode         ToNode           Length       Roughness    InOffset     OutOffset    InitFlow   MaxFlow   
;;---------------- ---------------- ---------------- ------------ ------------ ------------ ------------ ---------- ----------
C1               J1               J2               100 0.012999999999999999 0 0 0 0
C2               J2               O1               100 0.012999999999999999 0 0 0 0

[XSECTIONS]
;;Link             Shape            Geom1        Geom2        Geom3        Geom4        Barrels  Culvert 
;;---------------- ---------------- ------------ ------------ ------------ ------------ -------- --------
