;; Written by OpenSWMM for a SWMM 5.x engine: v6-only sections and options omitted; virtual and inlet junctions written as junctions.

[TITLE]
;;Project Title/Notes

[OPTIONS]
;;Option               Value
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         DYNWAVE
LINK_OFFSETS         DEPTH
MIN_SLOPE            0
ALLOW_PONDING        NO
SKIP_STEADY_STATE    NO

IGNORE_RAINFALL      NO
IGNORE_SNOWMELT      NO
IGNORE_GROUNDWATER   NO
IGNORE_RDII          NO
IGNORE_ROUTING       NO
IGNORE_QUALITY       NO

START_DATE           01/01/2004
START_TIME           00:00:00
REPORT_START_DATE    01/01/2004
REPORT_START_TIME    00:00:00
END_DATE             01/01/2004
END_TIME             00:00:00
SWEEP_START          1/1
SWEEP_END            12/31
DRY_DAYS             0
REPORT_STEP          0:15:00
WET_STEP             0:05:00
DRY_STEP             1:00:00
ROUTING_STEP         0:00:20
RULE_STEP            0:00:00

INERTIAL_DAMPING     PARTIAL
NORMAL_FLOW_LIMITED  BOTH
FORCE_MAIN_EQUATION  H-W
SURCHARGE_METHOD     EXTRAN
VARIABLE_STEP        0.75
LENGTHENING_STEP     0
MIN_SURFAREA         0
MAX_TRIALS           8
HEAD_TOLERANCE       0
SYS_FLOW_TOL         5
LAT_FLOW_TOL         5
MINIMUM_STEP         0.5
THREADS              1

[EVAPORATION]
;;Type       Parameters
;;---------- ----------
CONSTANT     0
DRY_ONLY     NO

[JUNCTIONS]
;;Name             Elev         MaxDepth     InitDepth    SurDepth     Aponded     
;;---------------- ------------ ------------ ------------ ------------ ------------
J1               0 5 0 0 0

[OUTFALLS]
;;Name             Elev         Type         Stage Data       Gated    Route To        
;;---------------- ------------ ------------ ---------------- -------- ----------------
O1               0 FREE         NO      

[CONDUITS]
;;Name             FromNode         ToNode           Length       Roughness    InOffset     OutOffset    InitFlow   MaxFlow   
;;---------------- ---------------- ---------------- ------------ ------------ ------------ ------------ ---------- ----------
L1               J1               O1               100 0.012999999999999999 0 0 0 0

[XSECTIONS]
;;Link             Shape            Geom1        Geom2        Geom3        Geom4        Barrels  Culvert 
;;---------------- ---------------- ------------ ------------ ------------ ------------ -------- --------
L1               CIRCULAR         1 0 0 0        1

[REPORT]
;;Keyword          Value
DISABLED             NO
INPUT                NO
CONTINUITY           YES
FLOWSTATS            YES
CONTROLS             NO
AVERAGES             NO
SUBCATCHMENTS        ALL
NODES                ALL
LINKS                ALL

[MAP]
DIMENSIONS 0 0 0 0
Units      None

[COORDINATES]
;;Node           X-Coord            Y-Coord           
;;-------------- ------------------ ------------------
J1               0 0
O1               0 0

[FILES]
;;Mode         FileType   Path
SAVE          HOTSTART   "auto.hsf"
SAVE          HOTSTART   "native.hsf"
SAVE          HOTSTART   "legacy.hsf" 01/14/2026 12:00:00
