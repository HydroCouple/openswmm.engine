[OPTIONS]
FLOW_UNITS           CFS
FLOW_ROUTING         DYNWAVE
START_DATE           01/01/2020
START_TIME           00:00:00
END_DATE             01/01/2020
END_TIME             01:00:00
REPORT_STEP          00:15:00
ROUTING_STEP         5

[STORAGE]
;;Name  Elev  MaxDepth  InitDepth  Shape       Coeff  Expon  Const
S1      0     10        2          FUNCTIONAL  0      0      1000

[OUTFALLS]
;;Name  Elev  Type
O1      0     FREE

[ORIFICES]
