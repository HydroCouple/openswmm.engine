[TITLE]
Post-open failure fixture: USE HOTSTART names a file that does not exist,
so open() succeeds and initialize() fails (CFFI_ERR_HOTSTART).

[OPTIONS]
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         DYNWAVE
LINK_OFFSETS         DEPTH
MIN_SLOPE            0
START_DATE           01/01/2020
START_TIME           00:00:00
END_DATE             01/01/2020
END_TIME             01:00:00
REPORT_STEP          00:05:00
WET_STEP             00:05:00
DRY_STEP             01:00:00
ROUTING_STEP         5

[FILES]
USE HOTSTART "warnerr_no_such_file.hsf"

[JUNCTIONS]
;;Name  Elev  MaxDepth  InitDepth  SurDepth  Aponded
J1       10    5         0          0         0

[OUTFALLS]
;;Name  Elev  Type  Stage  Gated
O1       0     FREE         NO

[CONDUITS]
;;Name  From  To   Length  Rough   In  Out  Init  Max
C1       J1    O1   400     0.01    0   0    0     0

[XSECTIONS]
;;Link  Shape     Geom1  Geom2  Geom3  Geom4  Barrels
C1       CIRCULAR  1.0    0      0      0      1

[COORDINATES]
J1  0    0
O1  100  0
