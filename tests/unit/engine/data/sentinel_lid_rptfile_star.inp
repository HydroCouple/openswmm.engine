[TITLE]
LID_USAGE RptFile '*' = no report file

[OPTIONS]
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         KINWAVE
LINK_OFFSETS         DEPTH
START_DATE           01/01/2020
START_TIME           00:00:00
END_DATE             01/01/2020
REPORT_STEP          00:15:00
WET_STEP             00:05:00
DRY_STEP             01:00:00
ROUTING_STEP         30
END_TIME             03:00:00

[RAINGAGES]
;;Name  Format     Interval  SCF  Source
G1      INTENSITY  1:00      1.0  TIMESERIES  TS1

[SUBCATCHMENTS]
;;Name  Gage  Outlet  Area  %Imperv  Width  Slope  CurbLen
S1      G1    J1      10    50       500    0.5    0

[SUBAREAS]
;;Subcatch  N-Imp  N-Perv  S-Imp  S-Perv  PctZero  RouteTo
S1          0.01   0.1     0.05   0.05    25       OUTLET

[INFILTRATION]
;;Subcatch  MaxRate  MinRate  Decay  DryTime  MaxInfil
S1          3.0      0.5      4      7        0

[LID_CONTROLS]
;;Name  Type/Layer  Parameters
RB      RB
RB      STORAGE     36   0.75  0.5  0
RB      DRAIN       1    0.5   0    6

[LID_USAGE]
;;Subcatch  LID  Number  Area  Width  InitSat  FromImp  ToPerv  RptFile  DrainTo
S1          RB   2       12    0      0        50       0       *

[JUNCTIONS]
;;Name  Elev  MaxDepth  InitDepth  SurDepth  Aponded
J1       2     5         0          0         0

[OUTFALLS]
;;Name  Elev  Type  Stage  Gated
O1       0     FREE         NO

[CONDUITS]
;;Name  From  To   Length  Rough   In  Out  Init  Max
C1       J1    O1   400     0.01    0   0    0     0

[XSECTIONS]
;;Link  Shape     Geom1  Geom2  Geom3  Geom4  Barrels
C1       CIRCULAR  1.0    0      0      0      1

[TIMESERIES]
;;Name  Time  Value
TS1     0:00  1.0
TS1     1:00  0.0

[REPORT]
SUBCATCHMENTS ALL
NODES ALL
LINKS ALL

