[TITLE]
;;Storage-shape regression fixture (US units) — see test_solver_storage_shapes.cpp
;;
;;STOR1 uses a nonlinear FUNCTIONAL shape (A0=50, A1=10, A2=2) that forces
;;storage_getDepth() into its Newton branch. J1 (node index 0) precedes STOR1
;;(node index 1, storage subIndex 0) so subIndex != node index, exercising the
;;"storage subIndex used as node index" bug. FLOW_UNITS is US (CFS), so
;;UCF(LENGTH) = UCF(VOLUME) = 1.0 here — this fixture is the US control that
;;must keep passing; storage_shapes_si.inp is the SI case that catches the
;;unit-mixing bug.

[OPTIONS]
;;Option             Value
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         KINWAVE
LINK_OFFSETS         DEPTH
MIN_SLOPE            0
ALLOW_PONDING        NO
SKIP_STEADY_STATE    NO

START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             02:00:00
SWEEP_START          01/01
SWEEP_END            12/31
DRY_DAYS             0
REPORT_STEP          00:05:00
WET_STEP             00:05:00
DRY_STEP             00:05:00
ROUTING_STEP         60
RULE_STEP            00:00:00

INERTIAL_DAMPING     PARTIAL
NORMAL_FLOW_LIMITED  BOTH
FORCE_MAIN_EQUATION  H-W
VARIABLE_STEP        0
LENGTHENING_STEP     0
MIN_SURFAREA         1.0
MAX_TRIALS           8
HEAD_TOLERANCE       0.0015
SYS_FLOW_TOL         5
LAT_FLOW_TOL         5
MINIMUM_STEP         0.5
THREADS              1
IGNORE_SNOWMELT      YES
IGNORE_QUALITY       YES

[JUNCTIONS]
;;Name           Elevation  MaxDepth  InitDepth  SurDepth  Aponded
J1               100        10        0          0         0

[OUTFALLS]
;;Name           Elevation  Type    Stage Data  Gated
O1               70         FREE                NO

[STORAGE]
;;Name  Elev  MaxDepth  InitDepth  Shape       A1  A2  A0  SurDepth  Fevap  Seep
STOR1   90    20        0          FUNCTIONAL  10  2   50  0         0

[CONDUITS]
;;Name  From  To     Length  Roughness  InOffset  OutOffset  InitFlow  MaxFlow
C1      J1    STOR1  200     0.013      0         0          0         0
C2      STOR1 O1     200     0.013      0         0          0         0

[XSECTIONS]
;;Link  Shape     Geom1  Geom2  Geom3  Geom4  Barrels
C1      CIRCULAR  4      0      0      0      1
C2      CIRCULAR  4      0      0      0      1

[INFLOWS]
;;Node  Constituent  Time Series  Type  Mfactor  Sfactor  Baseline  Pattern
J1      FLOW         INFLOW_TS    FLOW  1.0      1.0      0

[TIMESERIES]
;;Name       Date  Time   Value
INFLOW_TS          0:00   5.0
INFLOW_TS          2:00   5.0

[REPORT]
INPUT      NO
CONTROLS   NO
NODES      ALL
LINKS      ALL

[MAP]
DIMENSIONS 0 0 1000 1000
UNITS      None

[COORDINATES]
;;Node           X-Coord            Y-Coord
J1               0                  0
STOR1            200                0
O1               400                0
