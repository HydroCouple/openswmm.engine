[TITLE]
;;Project Title/Notes
CURVE_NUMBER regeneration parity deck. Two storms separated by a multi-day dry
spell so the SCS soil store must REGENERATE between events -- the behaviour
governed by the third [INFILTRATION] column (drying time). Legacy
curvenum_setParams() reads p[2]; the refactored engine must agree, otherwise
the second event infiltrates differently from the first.

Written 2026-08-03 because neither the QA suite nor the engine test decks
contained a single CURVE_NUMBER model.

[OPTIONS]
;;Option               Value
FLOW_UNITS           CFS
INFILTRATION         CURVE_NUMBER
FLOW_ROUTING         DYNWAVE
LINK_OFFSETS         DEPTH
MIN_SLOPE            0
ALLOW_PONDING        NO
SKIP_STEADY_STATE    NO
START_DATE           01/01/2026
START_TIME           00:00:00
END_DATE             01/09/2026
END_TIME             00:00:00
REPORT_START_DATE    01/01/2026
REPORT_START_TIME    00:00:00
REPORT_STEP          00:15:00
WET_STEP             00:05:00
DRY_STEP             01:00:00
ROUTING_STEP         30

[EVAPORATION]
;;Type     Parameters
CONSTANT   0.1
DRY_ONLY   NO

[RAINGAGES]
;;Name  Format     Interval  SCF   Source
RG1     INTENSITY  1:00      1.0   TIMESERIES TS1

[TIMESERIES]
;;Name  Date        Time   Value
;; Event 1 -- saturates the soil store
TS1     01/01/2026  00:00  0.0
TS1     01/01/2026  01:00  1.5
TS1     01/01/2026  02:00  1.5
TS1     01/01/2026  03:00  1.5
TS1     01/01/2026  04:00  0.0
;; Long dry spell: 5 days for the store to regenerate
TS1     01/06/2026  00:00  0.0
;; Event 2 -- identical storm; infiltration differs unless regen ran
TS1     01/06/2026  01:00  1.5
TS1     01/06/2026  02:00  1.5
TS1     01/06/2026  03:00  1.5
TS1     01/06/2026  04:00  0.0
TS1     01/09/2026  00:00  0.0

[SUBCATCHMENTS]
;;Name  Raingage  Outlet  Area  %Imperv  Width  %Slope  CurbLen
S1      RG1       J1      10.0  0        500    1.0     0
S2      RG1       J1      10.0  25       500    1.0     0

[SUBAREAS]
;;Subcatchment  N-Imperv  N-Perv  S-Imperv  S-Perv  PctZero  RouteTo
S1              0.015     0.24    0.06      0.3     25       OUTLET
S2              0.015     0.24    0.06      0.3     60       OUTLET

[INFILTRATION]
;;Subcatchment  CurveNum   Conduct    DryTime
S1              75         0.5        7
S2              85         0.5        2

[JUNCTIONS]
;;Name  Elevation  MaxDepth  InitDepth  SurDepth  Aponded
J1      100.0      10.0      0          0         0

[OUTFALLS]
;;Name  Elevation  Type  StageData  Gated  RouteTo
O1      95.0       FREE  *          NO     *

[CONDUITS]
;;Name  FromNode  ToNode  Length  Roughness  InOffset  OutOffset
C1      J1        O1      400     0.013      0         0

[XSECTIONS]
;;Link  Shape     Geom1  Geom2  Geom3  Geom4  Barrels
C1      CIRCULAR  3.0    0      0      0      1

[COORDINATES]
;;Node  X-Coord  Y-Coord
J1      0.0      0.0
O1      500.0    0.0

[MAP]
UNITS      FEET

[REPORT]
INPUT      NO
CONTROLS   NO
SUBCATCHMENTS ALL
NODES      ALL
LINKS      ALL
