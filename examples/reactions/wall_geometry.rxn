[REACTION_OPTIONS]
COUPLING FULL
RATE_UNITS SEC
WALL_GEOMETRY YES
AREA_UNITS M2
[REACTION_SPECIES]
BULK A MG
WALL W MG
[REACTION_COEFFICIENTS]
CONSTANT k 0.1
[REACTION_PIPES]
RATE A -k*A*AV
RATE W k*A
[REACTION_TANKS]
RATE A -k*A*AV
RATE W k*A
[REACTION_WALLS]
NODE Tank 100
LINK Pipe 500
[REACTION_QUALITY]
GLOBAL A 1
